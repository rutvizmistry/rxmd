{
  "name": "rxmd",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "RxMD - a QxMD-style journal library. An always-on server watches folders, files PDFs/EPUBs/etc. into a library, and serves a web reader (with annotations saved back into the files) to any browser on the LAN.",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "dev:all": "concurrently -n client,server -c cyan,green \"npm:dev\" \"npm:server:dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "set-password": "node server/set-password.js",
    "service:install": "node server/service.js install",
    "service:uninstall": "node server/service.js uninstall"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "adm-zip": "^0.5.16",
    "chokidar": "^4.0.3",
    "epubjs": "^0.3.93",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^5.4.10"
  }
}
